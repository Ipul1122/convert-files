# Konfigurasi Google Drive & Picker API
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Konfigurasi Supabase License & Anti-Sharing System (Gratis di supabase.com)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Tautan Pembayaran Otomatis (Lynk.id / Mayar / Midtrans)
# VITE_PURCHASE_URL=https://lynk.id/your_store_link_here
